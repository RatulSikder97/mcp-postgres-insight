# Connection string for the database to inspect. Use a dedicated read-only role.
# The value below matches the local docker-compose database (local use only).
DATABASE_URL=postgres://insight_reader:insight_reader@localhost:54329/insight

# Comma-separated schemas the agent may see. Everything else is invisible.
PG_ALLOWED_SCHEMAS=app

# stdio (default) or http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3333
# Required when MCP_HTTP_HOST is not a loopback address. Min 32 chars.
# MCP_HTTP_AUTH_TOKEN=
# Extra Host header values accepted by DNS-rebinding protection.
# MCP_HTTP_ALLOWED_HOSTS=

# Limits
STATEMENT_TIMEOUT_MS=5000
QUERY_MAX_ROWS=200
SAMPLE_MAX_ROWS=50
MAX_CELL_CHARS=512
MAX_SQL_LENGTH=20000
PG_POOL_MAX=4
SEQ_SCAN_ROW_THRESHOLD=10000
ALLOW_EXPLAIN_ANALYZE=true

# Redaction: case-insensitive regex matched against column names.
# REDACT_COLUMNS=(^|_)(email|phone|ssn|password|secret|token)($|_)
# Redact emails, card numbers and SSNs found inside text values.
REDACT_VALUES=true

LOG_LEVEL=info
